{
  "name": "flatmate-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Flatmate Matching Platform and Rental Property Marketplace for India",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@flatmate/web",
    "build:web": "npm run build --workspace=@flatmate/web",
    "start:web": "npm run start --workspace=@flatmate/web",
    "dev:mobile": "npm run start --workspace=@flatmate/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "flatmate",
    "rental",
    "property-marketplace",
    "india-real-estate",
    "nextjs",
    "expo",
    "supabase"
  ],
  "author": "NestMate Team",
  "license": "UNLICENSED"
}
